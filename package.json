{
    "name": "epicheck",
    "private": true,
    "description": "EpiCheck workspace: the Expo app (apps/mobile) and the CORS proxy (apps/proxy)",
    "scripts": {
        "start": "pnpm --filter mobile start",
        "android": "pnpm --filter mobile android",
        "ios": "pnpm --filter mobile ios",
        "ios:device": "pnpm --filter mobile ios:device",
        "web": "pnpm --filter mobile web",
        "proxy": "pnpm --filter proxy dev",
        "typecheck": "pnpm -r run typecheck",
        "lint": "pnpm -r run lint",
        "test": "pnpm -r --if-present run test",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,yaml}\"",
        "version:bump": "node scripts/version.mjs bump",
        "version:show": "node scripts/version.mjs show"
    },
    "devDependencies": {
        "prettier": "^3.7.3",
        "prettier-plugin-tailwindcss": "^0.7.2"
    },
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": ">=22"
    }
}
