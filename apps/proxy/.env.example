# Environment Configuration for EpiCheck Proxy Server

# Server Port
PORT=3001

# Browser origins allowed to call the proxy directly (comma-separated).
# Only needed when the web app runs on another origin (Expo dev server).
# Leave empty in production: nginx serves the app and /api on one origin.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Number of reverse proxies in front of the proxy (nginx, ingress), used to
# find the client address for the rate limit
TRUST_PROXY=1

# Requests per minute and per client address on /api/
RATE_LIMIT_PER_MINUTE=120

# Node Environment
NODE_ENV=development
