{
    "name": "epicheck-proxy-server",
    "version": "1.3.0",
    "description": "CORS proxy server for Epitech Intranet API",
    "main": "dist/app.js",
    "scripts": {
        "build": "tsc -p .",
        "start": "node dist/app.js",
        "dev": "node --watch-path=app.ts -r ts-node/register app.ts",
        "typecheck": "tsc -p . --noEmit",
        "test": "tsc -p . && node --test dist/*.test.js"
    },
    "keywords": [
        "cors",
        "proxy",
        "epitech"
    ],
    "author": "Alexandre Kévin DE FREITAS MARTINS",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.21.1",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "express-rate-limit": "^7.5.1",
        "helmet": "^7.2.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^22.20.5",
        "ts-node": "^10.9.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.5.2"
}
